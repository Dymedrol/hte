<section class="pets-advantages-section">
    <div class="pets-advantages-grid">
        <!-- Первая колонка -->
        <div class="pets-advantages-column">
            <!-- Карточка 1: Рыба не рекомендуется -->
            <div class="pets-advantage-card pets-advantage-card--1 pets-advantage-card--square" style="background-image: url({{ widget_settings.image1 | image_url: 960, format: 'webp', resizing_type: 'fit_width' }})">
                <div class="pets-advantage-card__content">
                    <h3 class="pets-advantage-card__title">{{ widget_settings.title1 }}</h3>
                    <p class="pets-advantage-card__subtitle">{{ widget_settings.text1 }}</p>
                </div>
            </div>
            
            <!-- Карточка 2: 1 раз в 2 дня -->
            <div class="pets-advantage-card pets-advantage-card--2 pets-advantage-card--light">
                <div class="pets-advantage-card__content">
                    <h3 class="pets-advantage-card__title">{{ widget_settings.title2 }}</h3>
                    <p class="pets-advantage-card__subtitle">{{ widget_settings.text2 }}</p>
                </div>
            </div>
        </div>
        
        <!-- Вторая колонка -->
        <div class="pets-advantages-column">
            <!-- Карточка 3: За 14 дней -->
            <div class="pets-advantage-card pets-advantage-card--3 pets-advantage-card--light">
                <div class="pets-advantage-card__content">
                    <h3 class="pets-advantage-card__title">{{ widget_settings.title3 }}</h3>
                    <p class="pets-advantage-card__subtitle">{{ widget_settings.text3 }}</p>
                </div>
            </div>
            
            <!-- Карточка 4: Начните с птицы -->
            <div class="pets-advantage-card pets-advantage-card--4 pets-advantage-card--square" style="background-image: url({{ widget_settings.image4 | image_url: 960, format: 'webp', resizing_type: 'fit_width' }})">
                <div class="pets-advantage-card__content">
                    <h3 class="pets-advantage-card__title">{{ widget_settings.title4 }}</h3>
                    <p class="pets-advantage-card__subtitle">{{ widget_settings.text4 }}</p>
                </div>
            </div>
        </div>
    </div>
</section>