<section class="advantages-section about-eco-solutions">
    <!-- Заголовок модуля -->
    <div class="eco-solutions-header">
        <h2 class="eco-solutions-title">{{ widget_settings.title }}</h2>
        <p class="eco-solutions-subtitle">{{ widget_settings.subtitle }}</p>
    </div>
    
    <div class="advantages-grid">
        <!-- Первая колонка -->
        <div class="advantages-column">
            <!-- Карточка 1: Экономит ресурсы -->
            <div class="advantage-card advantage-card--eco-resources advantage-card--square" style="background-image: url({{ widget_settings.image_card_1 | image_url: 600, format: 'webp', resizing_type: 'fit_width', quality: 100 }});">
                <div class="advantage-card__content">
                    <h3 class="advantage-card__title" style="color: white!important;">{{ widget_settings.title_card_1 }}</h3>
                    <p class="card-personalized-description" style="color: white!important; opacity:1!important;">{{ widget_settings.text_card_1 }}</p>
                </div>
            </div>
            
            <!-- Карточка 2: Сохраняет леса -->
            <div class="advantage-card advantage-card--light">
                <div class="advantage-card__content">
                    <h3 class="advantage-card__title">{{ widget_settings.title_card_2 }}</h3>
                    <p class="card-personalized-description">{{ widget_settings.text_card_2 }}</p>
                </div>
            </div>
            
            <!-- Карточка 3: Устойчивое производство -->
            <div class="advantage-card advantage-card--light">
                <div class="advantage-card__content">
                    <h3 class="advantage-card__title">{{ widget_settings.title_card_3 }}</h3>
                    <p class="card-personalized-description">{{ widget_settings.text_card_3 }}</p>
                </div>
            </div>
        </div>
        
        <!-- Вторая колонка -->
        <div class="advantages-column">
            <!-- Карточка 4: Снижает вред -->
            <div class="advantage-card advantage-card--light">
                <div class="advantage-card__content">
                    <h3 class="advantage-card__title">{{ widget_settings.title_card_4 }}</h3>
                    <p class="card-personalized-description">{{ widget_settings.text_card_4 }}</p>
                </div>
            </div>
            
            <!-- Карточка 5: Сокращение вредных сбросов -->
            <div class="advantage-card advantage-card--5card advantage-card--square" style="background-image: url({{ widget_settings.image_card_5 | image_url: 600, format: 'webp', resizing_type: 'fit_width', quality: 100 }});">
                <div class="advantage-card__content">
                    <h3 class="advantage-card__title" style="color: var(--hte-black)!important;">{{ widget_settings.title_card_5 }}</h3>
                    <p class="card-personalized-description" style="color: var(--hte-black)!important; opacity:0.5!important;">{{ widget_settings.text_card_5 }}</p>
                </div>
            </div>
            
            <!-- Карточка 6: Экономия места на свалках -->
            <div class="advantage-card advantage-card--light">
                <div class="advantage-card__content">
                    <h3 class="advantage-card__title">{{ widget_settings.title_card_6 }}</h3>
                    <p class="card-personalized-description">{{ widget_settings.text_card_6 }}</p>
                </div>
            </div>
        </div>
    </div>
</section>