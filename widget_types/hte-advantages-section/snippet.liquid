<section class="advantages-section">
    <div class="advantages-grid">
                    <!-- Первая колонка -->
            <div class="advantages-column">
                <!-- Карточка 1: Гибкий календарь -->
                <div class="advantage-card advantage-card--1 advantage-card--light {% if widget_settings.card1-is-hidden %}hidden-mobile{% endif %}">
                    <div class="advantage-card__content">
                        <h3 class="advantage-card__title">{{ widget_settings.card1-title }}</h3>
                    </div>
                </div>
                
                <!-- Карточка 2: Уникальное меню -->
                <div class="advantage-card advantage-card--2 advantage-card--tall {% if widget_settings.card2-is-hidden %}hidden-mobile{% endif %}" {% if widget_settings.card2-image %}style="background-image: url({{ widget_settings.card2-image | image_url: 500, format: 'webp', resizing_type: 'fit_width', quality: 100 }})"{% endif %}>
                    <div class="advantage-card__content">
                        <h3 class="advantage-card__title advantage-card__title--white">{{ widget_settings.card2-title }}</h3>
                    </div>
                </div>
                
                <!-- Карточка 3: Экологичная доставка -->
                <div class="advantage-card advantage-card--3 {% if widget_settings.card3-is-hidden %}hidden-mobile{% endif %}" {% if widget_settings.card3-image %}style="background-image: url({{ widget_settings.card3-image | image_url: 500, format: 'webp', resizing_type: 'fit_width', quality: 100 }})"{% endif %}>
                    <div class="advantage-card__content">
                        <h3 class="advantage-card__title" style="color: var(--hte-white) !important;">{{ widget_settings.card3-title }}</h3>
                        <a href="/collection/programmy" class="advantage-card__button">Подобрать программу питания</a>
                    </div>
                </div>
            </div>
            
            <!-- Вторая колонка -->
            <div class="advantages-column">
                <!-- Карточка 4: Премиальный сервис -->
                <div class="advantage-card advantage-card--4 advantage-card--square {% if widget_settings.card4-is-hidden %}hidden-mobile{% endif %}" {% if widget_settings.card4-image %}style="background-image: url({{ widget_settings.card4-image | image_url: 500, format: 'webp', resizing_type: 'fit_width', quality: 100 }})"{% endif %}>
                    <div class="advantage-card__content">
                        <h3 class="advantage-card__title advantage-card__title--white">{{ widget_settings.card4-title }}</h3>
                    </div>
                </div>
                
                <!-- Карточка 5: Современное производство -->
                <div class="advantage-card advantage-card--5 advantage-card--light {% if widget_settings.card5-is-hidden %}hidden-mobile{% endif %}">
                    <div class="advantage-card__content">
                        <h3 class="advantage-card__title">{{ widget_settings.card5-title }}</h3>
                    </div>
                </div>
                
                <!-- Карточка 6: Готовим без рафинированной муки -->
                <div class="advantage-card advantage-card--6 advantage-card--tall {% if widget_settings.card6-is-hidden %}hidden-mobile{% endif %}" {% if widget_settings.card6-image %}style="background-image: url({{ widget_settings.card6-image | image_url: 500, format: 'webp', resizing_type: 'fit_width', quality: 100 }})"{% endif %}>
                    <div class="advantage-card__content">
                        <h3 class="advantage-card__title">{{ widget_settings.card6-title }}</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section> 