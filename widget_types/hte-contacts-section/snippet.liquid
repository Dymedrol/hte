<!-- Contacts Section Component -->
<section class="contacts-section">
  <div class="contacts-container">
    <div class="contacts-content">
      <div class="contacts-header">
        <h1 class="contacts-title">{{ widget_settings.title }}</h1>
        <p class="contacts-subtitle">{{ widget_settings.subtitle }}</p>
      </div>
      
      <div class="contacts-info">
        <div class="contact-item">
          <div class="contact-label">Телефон</div>
          <div class="contact-details">
            <div class="contact-detail">
              <span class="contact-text">{{ widget_settings.phone }}</span>
              <img src="{{ 'copy-icon.svg' | asset_url }}" alt="Копировать" class="contact-icon">
            </div>
          </div>
        </div>
        
        <div class="contact-item">
          <div class="contact-label">Почта</div>
          <div class="contact-details">
            <div class="contact-detail">
              <span class="contact-text">{{ widget_settings.email }}</span>
              <img src="{{ 'copy-icon.svg' | asset_url }}" alt="Копировать" class="contact-icon">
            </div>
          </div>
        </div>
        
        <div class="contact-item">
          <div class="contact-label">Мессенджеры</div>
          <div class="contact-details">
            <div class="contact-detail">
              <span class="contact-text">{{ widget_settings.messenger }}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Requisites Section Component -->
<section class="requisites-section">
  <div class="requisites-container">
    <div class="requisites-content">
      <div class="requisites-item">
        <div class="requisites-label">Реквизиты</div>
        <div class="requisites-details">
          {{ widget_settings.requisites }}<br>
        </div>
      </div>
      
      <div class="requisites-item">
        <div class="requisites-label">Адрес</div>
        <div class="requisites-details">
          {{ widget_settings.address }}
        </div>
      </div>
    </div>
  </div>
</section> 