<div id="your-status-section"><section class="how-it-works-section your-status-section">
    <div class="how-it-works-container">
        <div class="how-it-works-content">
            <div class="how-it-works-card">
                <div class="how-it-works-inner">
                    <div class="how-it-works-header">
                        <h2 class="how-it-works-title">{{ widget_settings.title }}</h2>
                    </div>
                    
                    <div class="how-it-works-steps">
                        <div class="step-item">
                            <div class="step-number">{{ widget_settings.label-title-1 }}</div>
                            <p class="step-description">{{ widget_settings.label-text-1 }}</p>
                        </div>
                        
                        <div class="step-item">
                            <div class="step-number">{{ widget_settings.label-title-2 }}</div>
                            <p class="step-description">{{ widget_settings.label-text-2 }}</p>
                        </div>
                        
                        <div class="step-item">
                            <div class="step-number">{{ widget_settings.label-title-3 }}</div>
                            <p class="step-description">{{ widget_settings.label-text-3 }}</p>
                        </div>
                        
                        <div class="step-item">
                            <div class="step-number">{{ widget_settings.label-title-4 }}</div>
                            <p class="step-description">{{ widget_settings.label-text-4 }}</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="how-it-works-image">
                <img src="{{ widget_settings.image | image_url: 1200, format: 'webp', resizing_type: 'fit_width' }}" alt="Максимум вкуса и пользы">
            </div>
        </div>
    </div>
</section>
</div>