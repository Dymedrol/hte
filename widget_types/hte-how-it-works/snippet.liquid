<section class="how-it-works-section">
    <div class="how-it-works-container">
        <div class="how-it-works-content">
            <div class="how-it-works-card">
                <div class="how-it-works-inner">
                    <div class="how-it-works-header">
                        <h2 class="how-it-works-title">{{ widget_settings.title }}</h2>
                    </div>
                    
                    <div class="how-it-works-steps">
                        <div class="step-item">
                            <div class="step-number">01</div>
                            <p class="step-description">{{ widget_settings.step1-title }}</p>
                        </div>
                        
                        <div class="step-item">
                            <div class="step-number">02</div>
                            <p class="step-description">{{ widget_settings.step2-title }}</p>
                        </div>
                        
                        <div class="step-item">
                            <div class="step-number">03</div>
                            <p class="step-description">{{ widget_settings.step3-title }}</p>
                        </div>
                    </div>
                    
                    <div class="how-it-works-button">
                        <button class="start-eating-btn">{{ widget_settings.button-text }}</button>
                    </div>
                </div>
            </div>
            
            <div class="how-it-works-image">
                <img src="{{ widget_settings.image | image_url: 1420, format: 'webp', resizing_type: 'fit_width' }}" alt="Как все работает" />
            </div>
        </div>
    </div>
</section> 
