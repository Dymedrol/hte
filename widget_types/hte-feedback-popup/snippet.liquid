<!-- Feedback Popup Component -->
<div class="feedback-popup" id="feedbackPopup">
  <div class="popup-overlay"></div>
  <div class="popup-content">
    <!-- Левая секция с формой -->
    <div class="popup-left-section">
      <div class="popup-header">
        <h3 class="popup-title">ЗАПУТАЛИСЬ?</h3>
        <p class="popup-description">Оставьте заявку, и наш менеджер подберет для вас идеальную программу питания</p>
      </div>
      
      <form class="popup-form" method="post" action="/client_account/feedback" data-feedback-form-wrapper>

        <!-- Экран благодарности (скрыт по умолчанию) -->
        <div class="popup-thanks" id="popupThanks" style="display: none;">
          <div class="thanks-content">
            <h3 class="thanks-title">Спасибо!</h3>
            <p class="thanks-description">Ваша заявка отправлена. Мы свяжемся с вами в ближайшее время.</p>
          </div>
        </div>

        <div class="input-row">
          <div class="input-field" data-feedback-form-field-area>
            <input 
            name="name" 
            placeholder="Имя"
            data-feedback-form-field='{
              "isRequired": true, 
              "errorMessage": "Неправильно заполнено поле Имя"
            }' 
            type="text" 
            value="" />
            <div class="error-message" data-feedback-form-field-error></div>  
          </div>
          <div class="input-field" data-feedback-form-field-area>
            <input 
              name="phone"
              placeholder="Номер телефона"
              data-feedback-form-field='{
                "isRequired": true, 
                "errorMessage": "Неправильно заполнено поле Телефон", 
                "phoneNumberLength": 11
              }'
              type="text" 
              autocomplete="off" 
              value="" />  
            <div class="error-message" data-feedback-form-field-error></div>
          </div>
        </div>
        
        <div class="input-field" data-feedback-form-field-area>
          <input 
          name="from"
          placeholder="Email" 
          data-feedback-form-field='{"errorMessage": "Неправильно заполнено поле email"}' 
          type="text" 
          value="" /> 
          <div class="error-message" data-feedback-form-field-error></div>
        </div>
        
        <div class="input-field" data-feedback-form-field-area>
          <textarea
          rows="3"
          required 
          name="content"
          placeholder="Есть пожелания? Напишите здесь!" 
          data-feedback-form-field='{"errorMessage": "Введите пожелания"}'
          ></textarea> 
          <div class="error-message" data-feedback-form-field-error></div>
        </div>
        
        <div class="popup-checkbox" data-feedback-form-field-area>
          <label class="checkbox-label">
            <input 
              data-feedback-form-agree='{"errorMessage": "Необходимо подтвердить согласие"}' 
              type="checkbox" 
              name="agree" 
              value="" 
            />
            <span class="checkbox-custom"></span>
            <span class="checkbox-text">Оставляя e-mail, вы соглашаетесь с <a href="#" class="privacy-link">политикой конфиденциальности</a>.</span>
          </label>
          <div class="error-message" data-feedback-form-field-error></div>
        </div>

        {% if settings.feedback_captcha_enabled %}
          <div data-feedback-form-field-area class="feedback__field-area">
            <div data-feedback-form-recaptcha='{
              "isRequired": true, 
              "errorMessage": "{{messages.recaptcha_error | escape }}"
            }' 
            class="feedback__recaptcha"></div>
            <div data-feedback-form-field-error class="feedback__field-error"></div>
          </div>
        {% endif %}

        <input type="text" value="Заявка на подбор питания" name="subject" style="display: none;"/>
        <button class="feedback-popup-btn" id="feedbackPopupBtn">Получить консультацию</button>
      </form>
    </div>
    
    <!-- Правая секция с картинкой -->
    <div class="popup-right-section">
      <div class="food-display">
        <div class="food-image-bg" style="background-image: url({{ 'unique-menu.jpg' | asset_url }})"></div>
      </div>
    </div>
    
    <button class="popup-close" id="feedbackPopupClose">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 4L4 12M4 4L12 12" stroke="#9D9D9D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
</div>
