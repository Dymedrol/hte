<!-- FAQ Section -->
<section class="faq-section">
  <div class="faq-container">
    <h1 class="faq-title">{{ widget_settings.title }}</h1>
    
    <div class="faq-grid">
      <!-- Left Column -->
      <div class="faq-column">
        {% for block in data.blocks %}
          {% assign block_index = forloop.index | modulo: 2 %}
          {% if block_index == 1 %}
            <div class="faq-item" data-open="false">
              <div class="faq-header">
                <h3 class="faq-question">{{ block.item-title }}</h3>
                <div class="faq-icon">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M9 1.5V16.5M1.5 9H16.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              </div>
              <div class="faq-content">
                <p>{{ block.item-text }}</p>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <!-- Right Column -->
      <div class="faq-column">
        {% for block in data.blocks %}
          {% assign block_index = forloop.index | modulo: 2 %}
          {% if block_index == 0 %}
            <div class="faq-item" data-open="false">
              <div class="faq-header">
                <h3 class="faq-question">{{ block.item-title }}</h3>
                <div class="faq-icon">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M9 1.5V16.5M1.5 9H16.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              </div>
              <div class="faq-content">
                <p>{{ block.item-text }}</p>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>
