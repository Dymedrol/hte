<section class="cards-section personalized-menu-section cards-light-color">
  <div class="cards-container">
    <div class="card card-personalized">
      <div class="card-personalized-wrapper">
        <div class="card-personalized-titles">
          <div class="card-personalized-super-title">{{ widget_settings.title }}</div>
          <div class="card-personalized-title">{{ widget_settings.super_title }}</div>
        </div>
        <div class="card-personalized-image">
          <!--// <img src="{{'chef_small.jpg' | asset_url}}" alt="Шеф-повар" class="personalized-menu-img"> //-->
        </div>
        <div class="card-personalized-description">{{ widget_settings.subtitle }}</div>
      </div>
    </div>
    <div class="card">
      <img src="{{'pers-menu.jpg' | file_url}}" alt="Шеф-повар" class="card-image">
    </div>
  </div>
</section>