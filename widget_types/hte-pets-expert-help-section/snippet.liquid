<section class="pets-expert-help">
  <div class="pets-expert-help-container" style="background-image: url({{ widget_settings.image | image_url: 1200, format: 'webp', resizing_type: 'fit_width' }})">
    <div class="pets-expert-help-content">
      <div class="pets-expert-help-header">
        <h2 class="pets-expert-help-title">{{ widget_settings.title }}</h2>
        <p class="pets-expert-help-description">
          {{ widget_settings.text }}
        </p>
      </div>
      
      <div class="pets-expert-help-button">
        <button class="transparent-button open-feedback-popup">
          <span class="button-text">{{ widget_settings.button-text }}</span>
          <img class="button-arrow" src="{{ 'arrow-1.svg' | asset_url }}" alt="Arrow"> 
        </button>
      </div>
    </div>
  </div>
</section>