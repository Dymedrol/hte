<section class="cards-section personalized-menu-section about-how-we-create-menu cards-light-color">
  <div class="cards-container">
    <div class="card">
      <img src="{{ widget_settings.image | image_url: 1200, format: 'webp', resizing_type: 'fit_width' }}" alt="Шеф-повар" class="card-image">  
    </div>
    <div class="card card-personalized">
      <div class="card-personalized-wrapper">
        
        
        <div class="card-personalized-titles">
          <div class="card-personalized-super-title"> </div>
          <div class="card-personalized-title">{{ widget_settings.title }}</div>
          
        </div>
        <div class="card-personalized-description">{{ widget_settings.text }}</div>
      </div>
    </div>
    
  </div>
</section>