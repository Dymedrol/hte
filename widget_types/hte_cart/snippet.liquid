<div class="cart-items-section">
  <input type="hidden" name="_method" value="put">
  <input type="hidden" name="make_order" value="">
  {% if cart.items.size > 0 %}
    {% comment %} Подсчитываем товары для питомцев {% endcomment %}
    {% assign pets_items_count = 0 %}
    {% assign pets_total_price = 0 %}
    {% for item in cart.items %}
      {% if item.product.canonical_collection.url contains 'dlya-pitomtsev' %}
        {% assign pets_items_count = pets_items_count | plus: item.quantity %}
        {% assign pets_total_price = pets_total_price | plus: item.total_price %}
      {% endif %}
    {% endfor %}
    <form action="{{ cart_url }}" method="post" data-cart-form>
      <div class="cart-items-container">
        <!-- Заголовок корзины -->
        <div class="cart-title-container">
          <h1 class="cart-title">Корзина</h1>
          <span class="cart-items-count"><span class="count-number" data-cart-item-count></span> товара</span>
        </div>
        
        <!-- Контейнер с товарами -->
        <div class="cart-items-wrapper">
          <!-- Левая колонка с товарами -->
          <div class="cart-items-left">
            {% for item in cart.items %}
              {% unless item.product.canonical_collection.url contains 'dostavka' %}
                {% if item.product.canonical_collection.url contains 'program' %}
                <div class="cart-item cart-item_program" data-product-id="{{ item.product.id }}" data-item-id="{{ item.id }}" data-canonical-collection="{{ item.product.canonical_collection.url }}" data-product-handle="{{ item.product.handle }}">
                  <div class="item-counter" style="display: none;">
                    <div class="counter" data-quantity>
                      <button
                        type="button"
                        data-quantity-change="-1"
                        class="counter-button button button_size-s is-count-down ">
                        <span class="icon icon-minus"></span>
                      </button>
                      <input
                        type="text"
                        value="{{ item.quantity }}"
                        name="cart[quantity][{{item.id}}]"
                        class="counter-input form-control form-control_size-s" />
                      <button
                        type="button"
                        data-quantity-change="1"
                        class="counter-button button button_size-s is-count-up ">
                        <span class="icon icon-plus"></span>
                      </button>
                    </div>
                  </div>
                  <input data-comment type="text" name="cart[order_line_comments][{{ item.id }}]" value='{{ item.comment }}' style="display: none;"/>
                  <div class="cart-item-content">
                    <div class="cart-item-main">
                      <div class="cart-item-image" style="background-image: url({{ item.variant.first_image.medium_url }});"></div>
                      
                      <div class="cart-item-details">
                        <div class="cart-item-top">
                          <div class="cart-item-header">
                            <div class="cart-item-info">
                              <h2 class="cart-item-title">{{ item.product.title }}</h2>
                              {% if item.variant.option_values.size %}
                                <div class="cart-item-tags">
                                  {% for option_value in item.variant.option_values %}
                                    <span class="tag">{{ option_value.title }}</span>
                                  {% endfor %}                                          
                                </div>
                              {% endif %}
                            </div>
                            <button class="remove-item-btn js-item-delete" aria-label="Удалить товар" data-item-delete="{{ item.id }}" type="submit">
                              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                                <path d="M6 6L18 18M6 18L18 6" stroke="#9D9D9D" stroke-width="1.5"/>
                              </svg>
                            </button>
                          </div>
                          
                          <div class="cart-meal-options" data-item-accessories>
                            {% for accessory_line in item.accessory_lines %}
                              <div class="meal-option-item">
                                <span data-item-accessory-value-id="{{ accessory_line.accessory_value_id }}">{{ accessory_line.accessory_value_name }}</span>
                              </div>
                            {% endfor %}
                              {% assign comment_parts = item.comment | split: '|' %}
                              {% assign allergen_text = '' %}
                              {% for part in comment_parts %}
                                {% if part contains 'Аллергены:' %}
                                  {% assign allergen_part = part | split: 'Аллергены:' %}
                                  {% if allergen_part.size > 1 %}
                                    {% assign allergen_text = allergen_part[1] | strip %}
                                  {% endif %}
                                {% endif %}
                              {% endfor %}
                              
                              {% unless allergen_text contains 'Аллерген не выбран' %}
                                <div class="allergen-item">
                                  <span>Исключения: {{ allergen_text }}</span>
                                </div>
                              {% endunless %}
                          </div>
                        </div>
                        
                        <div class="cart-item-toggles">
                          <div class="toggle-item">
                            <div class="toggle-switch">
                              <div class="toggle-circle"></div>
                            </div>
                            <span>Исключить воду</span>
                          </div>
                          <div class="toggle-item">
                            <div class="toggle-switch">
                              <div class="toggle-circle"></div>
                            </div>
                            <span>Убрать приборы</span>
                          </div>
                        </div>
                      </div>
                    </div>
                    
                    <div class="cart-item-bottom">
                      <div class="delivery-info">
                          <div class="delivery-row">
                            <div class="info-icon" data-tooltip="Все дни кроме 18 августа, 19 августа">i</div>
                            <span class="delivery-label" id="delivery-date-label">Доставка:</span>
                            <span class="delivery-value">
                              {% assign comment_parts = item.comment | split: '|' %}
                              {% for part in comment_parts %}
                                {% if part contains 'Даты доставки:' %}
                                  {% assign date_part = part | split: 'Даты доставки:' %}
                                  {% if date_part.size > 1 %}
                                    {{ date_part[1] | strip }}
                                  {% endif %}
                                {% endif %}
                              {% endfor %}
                            </span>
                          </div>
                           <div class="delivery-row">
                            <div class="info-icon" data-tooltip="Доставка этого рациона осуществляется каждые 2 часа">i</div>
                            <span class="delivery-label" id="delivery-time-label">Время:</span>
                            <span class="delivery-value">
                              {% assign comment_parts = item.comment | split: '|' %}
                              {% for part in comment_parts %}
                                {% if part contains 'Время доставки:' %}
                                  {% assign time_part = part | split: 'Время доставки:' %}
                                  {% if time_part.size > 1 %}
                                    {{ time_part[1] | strip }}
                                  {% endif %}
                                {% endif %}
                              {% endfor %}
                            </span>
                          </div>
                      </div>

                      {% assign total_accessories_price = 0 %}
                      {% assign accessories_prices = item.accessory_lines | map: 'accessory_value_price' %}
                      {% for price in accessories_prices %}
                        {% assign total_accessories_price = total_accessories_price | plus: price %}
                      {% endfor %}
                      
                      <div class="price-breakdown">
                          <div class="price-row price-row_hide_mobile">
                            <span class="price-label">Программа:</span>
                            <span class="price-value">
                              <span class="price-amount">{{ item.variant.price | plus: total_accessories_price | money }}</span>
                              <span class="price-multiplier"> * {{ item.quantity }} 
                                {% assign quantity = item.quantity %}
                                {% assign last_digit = quantity | modulo: 10 %}
                                {% assign last_two_digits = quantity | modulo: 100 %}
                                {% if last_two_digits >= 11 and last_two_digits <= 19 %}
                                  дней
                                {% elsif last_digit == 1 %}
                                  день
                                {% elsif last_digit >= 2 and last_digit <= 4 %}
                                  дня
                                {% else %}
                                  дней
                                {% endif %}
                              </span>
                            </span>
                          </div>
                        <div class="price-row total">
                          <span class="price-label">Итого:</span>
                          <span class="price-value">
                            <span class="price-amount">{{ item.total_price | money }}</span>
                          </span>
                        </div>
                        <div class="mobile-remove-link">
                          <a href="#" class="remove-item-link">Удалить из корзины</a>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              {% else %}
                <div class="cart-item {% if item.product.canonical_collection.url contains 'dlya-pitomtsev' %}cart-item_pets{% endif %}" data-product-id="{{ item.product.id }}" data-item-id="{{ item.id }}" data-canonical-collection="{{ item.product.canonical_collection.url }}">
                  <div class="cart-item-content">
                    <div class="cart-item-main">
                      <div class="cart-item-image" style="background-image: url({{ item.variant.first_image.medium_url }});"></div>
                      
                      <div class="cart-item-details">
                        <div class="cart-item-top">
                          <div class="cart-item-header">
                            <div class="cart-item-info">
                              <h2 class="cart-item-title">{{ item.product.title }}</h2>
                            </div>
                            <button class="remove-item-btn js-item-delete" aria-label="Удалить товар" data-item-delete="{{ item.id }}" type="submit">
                              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                                <path d="M6 6L18 18M6 18L18 6" stroke="#9D9D9D" stroke-width="1.5"></path>
                              </svg>
                            </button>
                          </div>
                          
                          <div class="cart-item-extra-info">
                            
                            <div class="cart-item-quantity">
                              <div class="quantity-controls" data-quantity>
                                <button class="quantity-btn minus" data-quantity-change="-1">-</button>
                                <div class="quantity-value">
                                  <input
                                  type="text"
                                  value="{{ item.quantity }}"
                                  name="cart[quantity][{{item.id}}]"
                                  class="quantity-input"
                                /> 
                                  шт.</div>

                                <button class="quantity-btn plus" data-quantity-change="1">+</button>
                              </div>
                              <div class="quantity-price">
                                <span class="price-total">Итого: <span class="price-amount" data-cart-item-total-price>700</span></span>
                              </div>
                            </div>
                            

                            <div class="cart-item-program-info" style="display: none;">
                              <div class="program-badge with-icon">
                                <span>Добавить в программу</span>
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                                  <path d="M4 6L8 10L12 6" stroke="#9D9D9D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                                </svg>
                                <div class="program-dropdown">
                                  <div class="program-list">
                                    <div class="program-item" data-program="premium">ПРЕМИУМ</div>
                                    <div class="program-item" data-program="base">БАЗА</div>
                                    <div class="program-item" data-program="start">СТАРТ</div>
                                    <div class="program-item" data-program="sport">СПОРТ</div>
                                    <div class="program-item" data-program="detox">ДЕТОКС</div>
                                    <div class="program-item" data-program="perezagruzka">ПЕРЕЗАГРУЗКА</div>
                                  </div>
                                </div>
                              </div>
                              <div class="program-note">
                                <div class="info-icon" data-tooltip="Добавьте это блюдо из меню в свою программу, чтобы получать его вместе с выбранным рационом" style="--tooltip-left: 50%; --tooltip-transform: translateX(-50%);">i</div>
                                <span>Добавьте это блюдо из меню в свою программу, чтобы получать его вместе с выбранным рационом</span>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                {% endif %}
              {% endunless %}
            {% endfor %}
            
            {% comment %} Добавляем карточку "Рацион для питомца" если есть товары для питомцев {% endcomment %}
            {% if pets_items_count > 0 %}
              <div class="cart-item cart-item_pets-summary">
                <div class="cart-item-content">
                  <div class="cart-item-main">
                    <div class="cart-item-image" style="background-image: url({{ 'puppy-icon.png' | asset_url }});"></div>
                    
                    <div class="cart-item-details">
                      <div class="cart-item-top">
                        <div class="cart-item-header">
                          <div class="cart-item-info">
                            <h2 class="cart-item-title">Рацион для питомца</h2>
                            <div class="cart-item-tags">
                              <span class="tag">{{ pets_items_count }} 
                                {% assign quantity = pets_items_count %}
                                {% assign last_digit = quantity | modulo: 10 %}
                                {% assign last_two_digits = quantity | modulo: 100 %}
                                {% if last_two_digits >= 11 and last_two_digits <= 19 %}
                                  товаров
                                {% elsif last_digit == 1 %}
                                  товар
                                {% elsif last_digit >= 2 and last_digit <= 4 %}
                                  товара
                                {% else %}
                                  товаров
                                {% endif %}
                              </span>
                            </div>
                          </div>
                          <button class="remove-item-btn js-pets-delete" aria-label="Удалить все товары для питомцев" type="button">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                              <path d="M6 6L18 18M6 18L18 6" stroke="#9D9D9D" stroke-width="1.5"/>
                            </svg>
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                  
                  <div class="cart-item-bottom">
                    <div class="price-breakdown">
                      <div class="price-row total">
                        <span class="price-label">Итого:</span>
                        <span class="price-value">
                          <span class="price-amount">{{ pets_total_price | money }}</span>
                        </span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            {% endif %}
          </div>
        
          <!-- Правая колонка с итогами -->
          <div class="cart-summary">
            <div class="summary-card">
              <div class="promo-code-section" style="display: none;">
                <input type="text" class="promo-code-input" placeholder="Ввести промокод" />
              </div>
              
              <div class="summary-prices">
                <div class="summary-row">
                  <div><span data-cart-item-count></span> товара</div>
                  <div data-cart-total-price style="display: none;"></div>
                  <div id="cart-total-price"></div>
                </div>
                {% if pets_items_count > 0 %}
                <div class="summary-row">
                  <div>Рацион для питомца:</div>
                  <div>{{ pets_total_price | money }}</div>
                </div>
                {% endif %}
                <div class="summary-row" style="display: none">
                  <div>Скидка:</div>
                  <div class="discount">TODO</div>
                </div>
                <div class="summary-row">
                  <div>Доставка:</div>
                  <div id="delivery-price"> - </div>
                </div>
              </div>
              
              <div class="delivery-address">
                <button class="address-link" id="choose-delivery-address">Выбрать адрес доставки</button>
              </div>
              
              <div class="checkout-section">
                <div class="total-row">
                  <span class="total-label">Итого:</span>
                  <div class="total-amount">
                    <span class="total-price" data-cart-full-total-price></span>
                    {% comment %} <span class="total-period">/ день</span> {% endcomment %}
                  </div>
                </div>
                
                <button class="checkout-btn" id="checkoutBtn" disabled>Перейти к оформлению</button>
                
                <div class="delivery-note-summary">
                  Ближайшая доставка: загрузка...
                </div>
              </div>
            </div>
            
            <div class="additional-note-card">
              <p>N.B. Товары из полезного магазина доставляются в первый день доставки программы</p>
            </div>
          </div>
        </div>
        <input
          type="hidden"
          name="_method"
          value="put">
        <input
          type="hidden"
          name="make_order"
          value="">
        <input
          type="hidden"
          name="lang"
          value="{{ language.locale }}" />
      </form>
    {% else %}
      <div class="cart-items-container">
        <div class="cart-empty">
          <h1 class="cart-title">Корзина пуста</h1>
        </div>
      </div>
    {% endif %}
</div>

<!-- Попап для выбора адреса доставки -->
<div class="address-popup" id="addressPopup">
  <div class="popup-overlay"></div>
  <div class="popup-content">
    <button class="popup-close" id="addressPopupClose">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 4L4 12M4 4L12 12" stroke="#9D9D9D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    
    <div class="popup-header">
      <h2 class="popup-title">Укажите ваш адрес</h2>
      <p class="popup-description">Введите адрес или выберите точку на карте для расчета доступных слотов доставки.</p>
    </div>
    
    <div class="popup-body">
      <!-- Шаг 1: Выбор адреса на карте -->
      <div class="step-container" id="step1">
        <!-- Поле ввода адреса -->
        <div class="address-input-section">
          <div class="input-group">
            <input 
              type="text" 
              id="addressInput" 
              class="address-input" 
              placeholder="Введите адрес или выберите на карте"
              autocomplete="off"
            />
            <button type="button" id="searchAddressBtn" class="search-btn">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M9 17C13.4183 17 17 13.4183 17 9C17 4.58172 13.4183 1 9 1C4.58172 1 1 4.58172 1 9C1 13.4183 4.58172 17 9 17Z" stroke="currentColor" stroke-width="2"/>
                <path d="M19 19L14.65 14.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
          <div id="addressSuggestions" class="address-suggestions"></div>
        </div>
        
        <!-- Контейнер для карты -->
        <div class="map-section">
          <div id="yandexMap" class="yandex-map"></div>
          <div class="map-controls">
            <button type="button" id="useCurrentLocation" class="location-btn">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M8 1C5.24 1 3 3.24 3 6C3 9.5 8 15 8 15S13 9.5 13 6C13 3.24 10.76 1 8 1ZM8 8.25C6.76 8.25 5.75 7.24 5.75 6C5.75 4.76 6.76 3.75 8 3.75C9.24 3.75 10.25 4.76 10.25 6C10.25 7.24 9.24 8.25 8 8.25Z" fill="currentColor"/>
              </svg>
              Мое местоположение
            </button>
          </div>
        </div>
        
        <!-- Выбранный адрес -->
        <div class="selected-address-section">
          <div class="selected-address-info">
            <div class="address-label">Выбранный адрес:</div>
            <div id="selectedAddress" class="selected-address">Адрес не выбран</div>
          </div>
          <button type="button" id="confirmAddressBtn" class="confirm-btn" disabled>
            Подтвердить адрес
          </button>
        </div>
      </div>

      <!-- Шаг 2: Детали доставки -->
      <div class="step-container" id="step2">
        <!-- Адрес из первого шага (только для чтения) -->
        <div class="confirmed-address-section">
          <div class="address-label">Адрес доставки:</div>
          <div id="confirmedAddress" class="confirmed-address"></div>
          <button type="button" id="backToStep1Btn" class="back-btn">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Изменить адрес
          </button>
        </div>

        <!-- Детали доставки -->
        <div class="delivery-details-section">
          <div class="form-group">
            <div class="toggle-container">
              <input type="checkbox" id="houseTypeToggle" class="toggle-input">
              <label for="houseTypeToggle" class="toggle-label">
                <span class="toggle-switch">
                  <span class="toggle-slider"></span>
                </span>
                <span class="toggle-text">Частный дом</span>
              </label>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <input type="text" id="apartmentInput" class="form-input" placeholder="Квартира">
            </div>
            <div class="form-group">
              <input type="text" id="floorInput" class="form-input" placeholder="Этаж">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <input type="text" id="entranceInput" class="form-input" placeholder="Подъезд">
            </div>
            <div class="form-group">
              <input type="text" id="intercomInput" class="form-input" placeholder="Домофон">
            </div>
          </div>

          <div class="form-group">
            <input 
              id="courierCommentInput" 
              class="form-input" 
              placeholder="Комментарий для курьера"
              maxlength="300"
            >
            <span class="char-counter" id="charCounter">0/300</span>
          </div>
        </div>

        <!-- Кнопка подтверждения -->
        <div class="final-confirmation-section">
          <button type="button" id="finalConfirmBtn" class="final-confirm-btn">
            Привезти сюда
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
    // Устанавливаем текущее время по московскому времени (UTC+3)
    // Используется для корректного отображения дат в календаре и расчета доступности доставки
    const moscowOffset = 3; // Москва UTC+3
    const now = new Date();
    const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
    window.currentTime = new Date(utc + (moscowOffset * 3600000));
</script>

<script>
  // JSON данные продуктов из коллекции "dostavka"
  window.dostavkaProducts = {
    "collection": {
      "handle": "{{ collections.dostavka.handle }}",
      "title": "{{ collections.dostavka.title | escape }}",
      "description": "{{ collections.dostavka.description | escape }}",
      "products_count": {{ collections.dostavka.products_count }},
      "url": "{{ collections.dostavka.url }}"
    },
    "products": [
      {% for product in collections.dostavka.products %}
        {
          "id": {{ product.id }},
          "handle": "{{ product.handle }}",
          "title": "{{ product.title | escape }}",
          "description": "{{ product.description | strip_html | escape }}",
          "price": {{ product.price }},
          "price_formatted": "{{ product.price | money }}",
          "available": {{ product.available }},
          "url": "{{ product.url }}",
          "created_at": "{{ product.created_at | date: '%Y-%m-%dT%H:%M:%S%z' }}",
          "updated_at": "{{ product.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' }}",
          "vendor": "{{ product.vendor | escape }}",
          "product_type": "{{ product.product_type | escape }}",
          "tags": [
            {% for tag in product.tags %}
              "{{ tag | escape }}"{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ],
          "images": [
            {% for image in product.images %}
              {
                "id": {{ image.id }},
                "alt": "{{ image.alt | escape }}",
                "src": "{{ image.src }}",
                "original_url": "{{ image.original_url }}",
                "large_url": "{{ image.large_url }}",
                "medium_url": "{{ image.medium_url }}",
                "small_url": "{{ image.small_url }}",
                "thumb_url": "{{ image.thumb_url }}"
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ],
          "variants": [
            {% for variant in product.variants %}
              {
                "id": {{ variant.id }},
                "title": "{{ variant.title | escape }}",
                "price": {{ variant.price }},
                "price_formatted": "{{ variant.price | money }}",
                "compare_at_price_formatted": "{{ variant.compare_at_price | money }}",
                "available": {{ variant.available }},
                "sku": "{{ variant.sku | escape }}",
                "weight_unit": "{{ variant.weight_unit }}",
                "option1": "{{ variant.option1 | escape }}",
                "option2": "{{ variant.option2 | escape }}",
                "option3": "{{ variant.option3 | escape }}"
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ],
          "options": [
            {% for option in product.options %}
              {
                "name": "{{ option.name | escape }}",
                "position": {{ option.position }},
                "values": [
                  {% for value in option.values %}
                    "{{ value | escape }}"{% unless forloop.last %},{% endunless %}
                  {% endfor %}
                ]
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  };
</script>

