<section class="cards-section personalized-menu-with-button-section">
  <div class="cards-container">
    <div class="card card-personalized">
      <div class="card-personalized-wrapper">
        <div class="card-personalized-titles">
          <div class="card-personalized-super-title">{{ widget_settings.title }}</div>
          <div class="card-personalized-title">{{ widget_settings.subtitle }}</div>
        </div>  
        <div class="card-personalized-description">{{ widget_settings.text }}</div>
        <div class="card-personalized-image">
        </div>
        <a href="#open_feedback_popup" class="black-btn">{{ widget_settings.button-text }}</a>
      </div>
    </div>
    <div class="card">
      <img src="{{ widget_settings.image | image_url: 1200, format: 'webp', resizing_type: 'fit_width' }}" alt="Менеджер" class="card-image">
    </div>
  </div>
</section>