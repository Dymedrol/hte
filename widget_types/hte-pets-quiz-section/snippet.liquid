<!-- Pets Quiz Component - Step 1 (объединенный с выбором веса) -->
<div class="pets-quiz-section" id="step-1">
  <div class="pets-quiz-container">
    <!-- Step Progress -->
    <div class="step-progress">
      <div class="step-info">
        <span class="step-number">Шаг 1</span>
        <span class="step-counter">1/3</span>
      </div>
      <div class="progress-bar">
        <div class="progress-segment active"></div>
        <div class="progress-segment"></div>
        <div class="progress-segment"></div>
      </div>
    </div>

    <!-- Quiz Title -->
    <h1 class="quiz-title">Рассчитайте рацион вашего питомца</h1>

    <!-- Pet Options -->
    <div class="pet-options">
      <!-- Option 1: Puppies -->
      <div class="pet-option" data-pet-type="puppy">
        <div class="pet-card">
          <div class="pet-image puppy-image" style="background-image: url('{{ 'puppy-icon.png' | asset_url }}');"></div>
          <div class="selected-badge" style="display: none;">Выбрано</div>
        </div>
        <p class="pet-label">Для щенков</p>
        
        <!-- Weight Selector (скрыт по умолчанию) -->
        <div class="weight-selector" style="display: none;">
          <div class="weight-counter">
            <button class="weight-btn minus-btn" type="button">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </button>
            <div class="weight-input-container">
              <input type="number" class="weight-input" value="5" min="0.1" step="0.5" pattern="[0-9]*\.?[0-9]*" inputmode="decimal">
              <span class="weight-placeholder">кг</span>
            </div>
            <button class="weight-btn plus-btn" type="button">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
          <button class="btn btn-primary" id="btn-next-step1-puppy">Далее</button>
        </div>
      </div>

      <!-- Option 2: Adult Dogs -->
      <div class="pet-option" data-pet-type="adult-dog">
        <div class="pet-card">
          <div class="pet-image adult-dog-image" style="background-image: url('{{ 'dog-icon.png' | asset_url }}');"></div>
          <div class="selected-badge" style="display: none;">Выбрано</div>
        </div>
        <p class="pet-label">Для взрослой собаки</p>
        
        <!-- Weight Selector (скрыт по умолчанию) -->
        <div class="weight-selector" style="display: none;">
          <div class="weight-counter">
            <button class="weight-btn minus-btn" type="button">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </button>
            <div class="weight-input-container">
              <input type="number" class="weight-input" value="25" min="0.1" step="0.5" pattern="[0-9]*\.?[0-9]*" inputmode="decimal">
              <span class="weight-placeholder">кг</span>
            </div>
            <button class="weight-btn plus-btn" type="button">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
          <button class="btn btn-primary" id="btn-next-step1-adult-dog">Далее</button>
        </div>
      </div>

      <!-- Option 3: Kittens and Cats -->
      <div class="pet-option" data-pet-type="cat">
        <div class="pet-card">
          <div class="pet-image cat-image" style="background-image: url('{{ 'cat-icon.png' | asset_url }}');"></div>
          <div class="selected-badge" style="display: none;">Выбрано</div>
        </div>
        <p class="pet-label">Для котят и кошек</p>
        
        <!-- Weight Selector (скрыт по умолчанию) -->
        <div class="weight-selector" style="display: none;">
          <div class="weight-counter">
            <button class="weight-btn minus-btn" type="button">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </button>
            <div class="weight-input-container">
              <input type="number" class="weight-input" value="4" min="0.1" max="100" step="0.1" pattern="[0-9]*\.?[0-9]*" inputmode="decimal">
              <span class="weight-placeholder">кг</span>
            </div>
            <button class="weight-btn plus-btn" type="button">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
          <button class="btn btn-primary" id="btn-next-step1-cat">Далее</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Step 2: Выбор аллергенов (бывший шаг 3) -->
<div class="pets-quiz-step" id="step-2" style="display: none;">
  <div class="pets-quiz-container">
    <!-- Step Progress -->
    <div class="step-progress">
      <div class="step-info">
        <span class="step-number">Шаг 2</span>
        <span class="step-counter">2/3</span>
      </div>
      <div class="progress-bar">
        <div class="progress-segment active"></div>
        <div class="progress-segment active"></div>
        <div class="progress-segment"></div>
      </div>
    </div>

    <!-- Quiz Title -->
    <h1 class="quiz-title">Если необходимо, выберите продукты, которые нужно исключить из рациона:</h1>

    <!-- Products List -->
    <div class="products-list">
      <div class="product-item" data-product="Говядина">
        <div class="product-card">
          <p class="product-label">Говядина</p>
        </div>
      </div>
      
      <div class="product-item" data-product="Курица">
        <div class="product-card">
          <p class="product-label">Курица</p>
        </div>
      </div>
      
      <div class="product-item" data-product="Рыба">
        <div class="product-card">
          <p class="product-label">Рыба</p>
        </div>
      </div>
      
      <div class="product-item" data-product="Индейка">
        <div class="product-card">
          <p class="product-label">Индейка</p>
        </div>
      </div>
      
      <div class="product-item" data-product="Огурец">
        <div class="product-card">
          <p class="product-label">Огурец</p>
        </div>
      </div>
      
      <div class="product-item" data-product="Кабачок">
        <div class="product-card">
          <p class="product-label">Кабачок</p>
        </div>
      </div>
      
      <div class="product-item" data-product="Тыква">
        <div class="product-card">
          <p class="product-label">Тыква</p>
        </div>
      </div>
      
      <div class="product-item" data-product="Морковь">
        <div class="product-card">
          <p class="product-label">Морковь</p>
        </div>
      </div>
      
      <div class="product-item" data-product="Капуста цветная">
        <div class="product-card">
          <p class="product-label">Капуста цветная</p>
        </div>
      </div>
      
      <div class="product-item" data-product="Капуста белокачанная">
        <div class="product-card">
          <p class="product-label">Капуста белокачанная</p>
        </div>
      </div>
      
      <div class="product-item" data-product="Рис">
        <div class="product-card">
          <p class="product-label">Рис</p>
        </div>
      </div>
    </div>

    <!-- Navigation Buttons -->
    <div class="quiz-navigation">
      <button class="btn btn-secondary" id="btn-back-step2">Назад</button>
      <button class="btn btn-primary" id="btn-next-step2">Рассчитать</button>
    </div>
  </div>
</div>

<!-- Step 3: Итоговый экран с результатами (бывший шаг 4) -->
<div class="pets-quiz-step" id="step-3" style="display: none;">
  <div class="pets-quiz-container">
    <!-- Step Progress -->
    <div class="step-progress">
      <div class="step-info">
        <span class="step-number">Шаг 3</span>
        <span class="step-counter">3/3</span>
      </div>
      <div class="progress-bar">
        <div class="progress-segment active"></div>
        <div class="progress-segment active"></div>
        <div class="progress-segment active"></div>
      </div>
    </div>

    <!-- Quiz Title -->
    <h1 class="quiz-title">Мы подготовили программу для вашего питомца на неделю:</h1>

    <!-- Results Content -->
    <div class="results-content">
      <!-- Pet Result Image -->
      <div class="pet-result-image">
        <div class="image-container result-dog">
          <!-- Картинка будет меняться в зависимости от выбранного питомца -->
        </div>
      </div>
      
      <!-- Results Info -->
      <div class="results-info">
        <div class="info-content">
          <p class="diet-info" id="diet-info">Ваш рацион: <span id="daily-amount">120</span> г корма в сутки</p>
          <p class="packages-info" id="packages-info">Это <span id="weekly-packages">9</span> пакетиков по <span id="package-size">100</span> г на неделю</p>
        </div>
      </div>
    </div>

    <!-- Navigation Buttons -->
    <div class="quiz-navigation">
      <button class="btn btn-secondary" id="btn-back-step3">Назад</button>
      <button class="btn btn-primary" id="btn-add-to-cart">Добавить в корзину</button>
    </div>
  </div>
</div>

<!-- Delivery Time Popup -->
<div class="quantity-popup" id="deliveryDatePopup">
  <div class="popup-overlay"></div>
  <div class="popup-content">
    <div class="popup-left-section">
      <div class="popup-form">
        <div class="popup-header">
          <h3 class="popup-title">ВЫБЕРИТЕ УДОБНОЕ ВРЕМЯ ДОСТАВКИ!</h3>
          <p class="popup-description">Пожалуйста, укажите желаемую дату и временной слот для доставки. Мы постараемся привезти заказ в выбранное время</p>
        </div>
        
        <div class="popup-inputs">
          <div class="input-row">
            <div class="input-field">
              <input type="text" placeholder="Дата доставки" id="deliveryDateInput" readonly />
              <div class="calendar-dropdown" id="deliveryDateCalendar">
                <div class="calendar-header">
                  <button class="calendar-nav-btn prev-btn" id="deliveryCalendarPrev">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M10 12L6 8L10 4" stroke="#9D9D9D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  <div class="calendar-title">
                    <span class="calendar-month">Месяц</span>
                    <span class="calendar-year">2025</span>
                  </div>
                  <button class="calendar-nav-btn next-btn" id="deliveryCalendarNext">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M6 4L10 8L6 12" stroke="#9D9D9D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>
                <div class="calendar-grid" id="deliveryCalendarGrid">
                  <!-- Дни недели -->
                  <div class="calendar-day-header">Пн</div>
                  <div class="calendar-day-header">Вт</div>
                  <div class="calendar-day-header">Ср</div>
                  <div class="calendar-day-header">Чт</div>
                  <div class="calendar-day-header">Пт</div>
                  <div class="calendar-day-header">Сб</div>
                  <div class="calendar-day-header">Вс</div>
                  <!-- Дни месяца будут добавлены динамически -->
                </div>
              </div>
            </div>
            <div class="input-field with-icon">
              <input type="text" placeholder="В какое время доставить?" id="deliveryTimeInput" readonly />
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 6L8 10L12 6" stroke="#9D9D9D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <div class="delivery-time-dropdown" id="deliveryTimeDropdown">
                <div class="time-list" id="timeList">
                  <div class="time-item" data-time="06:00-07:00">06:00 - 07:00</div>
                  <div class="time-item" data-time="07:00-08:00">07:00 - 08:00</div>
                  <div class="time-item" data-time="08:00-09:00">08:00 - 09:00</div>
                  <div class="time-item" data-time="09:00-10:00">09:00 - 10:00</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="popup-footer">
        <button class="add-to-cart-popup-btn" id="deliveryPopupConfirm" disabled>Добавить в корзину</button>
      </div>
    </div>
    
    <div class="popup-right-section">
      <div class="popup-image" id="popupImage">
        <div class="image-overlay">
          <h2 class="image-title" id="popupImageTitle">РАЦИОН ДЛЯ ПИТОМЦА</h2>
        </div>
      </div>
    </div>
    
    <button class="popup-close" id="deliveryPopupClose">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 4L4 12M4 4L12 12" stroke="#9D9D9D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
</div>

<!-- Loading Overlay -->
<div class="pets-quiz-loading-overlay" id="petsQuizLoadingOverlay">
  <div class="loading-content">
    <div class="loading-spinner">
      <div class="spinner-ring"></div>
      <div class="spinner-ring"></div>
      <div class="spinner-ring"></div>
    </div>
    <p class="loading-text">Добавляем товары в корзину...</p>
    <p class="loading-subtext">Пожалуйста, подождите</p>
  </div>
</div>

<script>
  window.petsProducts = {
    "collection": {
      "handle": "{{ collections.dlya-pitomtsev.handle }}",
      "title": "{{ collections.dlya-pitomtsev.title | escape }}",
      "description": "{{ collections.dlya-pitomtsev.description | escape }}",
      "products_count": {{ collections.dlya-pitomtsev.products_count }},
      "url": "{{ collections.dlya-pitomtsev.url }}"
    },
    "products": [
      {% for product in collections.dlya-pitomtsev.products %}
        {
          "id": {{ product.id }},
          "handle": "{{ product.handle }}",
          "title": "{{ product.title | escape }}",
          "price": {{ product.price }},
          "available": {{ product.available }},
          "variants": [
            {% for variant in product.variants %}
              {
                "id": {{ variant.id }},
                "title": "{{ variant.title | escape }}",
                "price": {{ variant.price }},
                "available": {{ variant.available }},
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ],
          "options": [
            {% for option in product.options %}
              {
                "name": "{{ option.name | escape }}",
                "position": {{ option.position }},
                "values": [
                  {% for value in option.values %}
                    "{{ value | escape }}"{% unless forloop.last %},{% endunless %}
                  {% endfor %}
                ]
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  };
</script>
